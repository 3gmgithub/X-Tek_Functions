#!/bin/bash

## Change this to something other than 'n' to remove the prompt
ANSWER=n

# Config docker user
DUSER="PUTUSERHERE"

#*********************************************************************#
#   Most everyone will not need to modify anything below this point   #
#*********************************************************************#

# Docker User Password 
DUSERPW="$(openssl rand -base64 128 | grep -o '[[:alnum:]]' | tr -d '\n' | head -c${1:-16})"

# Get Script DIR
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
SCRIPT_NAME="$(basename "$0")"

# GIT VARS
GIT_OWNER="3gmgithub"
GIT_REPO="X-Tek_Functions"

#***********************************#
#   DO NOT CHANGE BELOW THIS LINE   #
#***********************************#

download-lib () {
    LIB_NAME="${1}"
    
    # Download
    echo "Downloading and adding ${LIB_NAME} to source..."
    source <(curl -sSL "https://raw.githubusercontent.com/${GIT_OWNER}/${GIT_REPO}/refs/heads/main/${LIB_NAME}")
}

# Get functions from GIT
download-lib "docker-func"
download-lib "std-func"

# Run check-answer
check-answer

# Install defaults
defaults

# Install packages
declare -a my-packages=(
    "argon2"
    "mariadb-client-compat"
)

install-packages "${my-packages[@]}"

# Install docker
install-docker

# Create Docker user
create-duser

# Messages

# Show password for records
echo -e "\nMake sure to record ${DUSER} password: ${DUSERPW}"